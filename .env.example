# סיסמת כניסה למערכת. ריק = בלי סיסמה (רק להרצה מקומית). באתר מאורח – חובה.
APP_PASSWORD=""

# --- מסד נתונים (חובה) ---
DATABASE_URL="postgresql://broker:broker@localhost:5432/valuation?schema=public"

# --- מודל שפה (אופציונלי). בלי מפתח המערכת מפיקה סיכום מבוסס תבנית מהנתונים בלבד ---
AI_PROVIDER="anthropic"            # anthropic | template
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# --- מקורות מידע (שלב 2). כל עוד ריקים, המחבר מוצג כ"לא מחובר" ---
GOVMAP_ENABLED="false"              # עסקאות רשות המסים דרך GovMap (אפשר גם להפעיל מהמסך)
GOVIL_NADLAN_ENABLED="false"        # מאגר עסקאות הנדל"ן הממשלתי - דורש אישור/ממשק רשמי
LISTINGS_PROVIDER_URL=""            # ספק מודעות מורשה (למשל ספק נתונים בהסכם עם יד2)
LISTINGS_PROVIDER_API_KEY=""

# --- הדגמה ---
DEMO_DATA_ENABLED="true"            # הצגת נתוני הדגמה סינתטיים (מסומנים בבירור)

# --- ייצוא PDF בצד השרת (אופציונלי). בלי זה, הייצוא נעשה דרך הדפסה לדפדפן ---
CHROMIUM_PATH=""

# --- הגנה מפני שימוש יתר ---
RATE_LIMIT_PER_MINUTE="60"
